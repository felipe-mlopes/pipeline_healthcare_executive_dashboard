			        [_Valor_Base_Custo],
			        'F - Aberturas por Risco'[Risco] = "Odontológico"
			    ),
			    CALCULATE(
			        [_Valor_Base_Vidas],
			        'F - Aberturas por Risco'[Tipo_plano] = "odontológico"
			    )
			)
		formatString: #,0.00
