	measure 'Narrativa Top UF' =
			
			VAR TabelaUF =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES('F - Aberturas por Risco'[uf_benef]),
			            "@PerCapita", [_YTD_Grande_Risco_Periodo_Atual],
			            "@Vidas", [_Total_Vidas_YTD_Media]
			        ),
			        [@Vidas] > 100
			    )
			
			VAR TopUF =
			    TOPN(
			        1,
			        TabelaUF,
			        [@PerCapita],
			        DESC
			    )
			
			VAR UF =
			    MAXX(TopUF, 'F - Aberturas por Risco'[uf_benef])
			
			VAR Valor =
			    MAXX(TopUF, [@PerCapita])
			
			RETURN
			    "Em 2026, na operadora AMS, a UF com maior per capita em Grande Risco foi "
			        & UF
			        & ", registrando "
			        & FORMAT(Valor, "R$ #,##0.00")
			        & " por beneficiário."
		lineageTag: d68b4fde-032c-4252-87f6-7e284690e62d

	measure _Narrativa_Top1_Ofensores_POS = ```
			
			VAR _TabelaUF_POS =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES('F - Aberturas por Risco'[uf_benef]),
			            "@GR",
			            VAR _UF = [uf_benef]
			            RETURN
			                DIVIDE(
			                    CALCULATE(
			                        SUM('F - Aberturas por Risco'[Valor]),    
			                        'F - Aberturas por Risco'[Risco] = "Grande Risco",
			                        'F - Aberturas por Risco'[Operadora] = "Operadora Y",
			                        DATESYTD('D - Calendario'[Date])
			                    ),
			                    CALCULATE(
			                        SUM('F - Vidas'[Valor]),
			                        'F - Vidas'[Tipo_plano] = "médico",
			                        'F - Vidas'[Operadora] = "Operadora Y",
			                        TREATAS({_UF}, 'F - Vidas'[uf_benef]),
			                        DATESYTD('D - Calendario'[Date])
			                    )
			                ),
			            "@PR",
			            VAR _UF = [uf_benef]
			            RETURN
			                DIVIDE(
			                    CALCULATE(
			                        SUM('F - Aberturas por Risco'[Valor]),    
			                        'F - Aberturas por Risco'[Risco] = "Pequeno Risco",
			                        'F - Aberturas por Risco'[Operadora] = "Operadora Y",
			                        DATESYTD('D - Calendario'[Date])
			                    ),
			                    CALCULATE(
			                        SUM('F - Vidas'[Valor]),
			                        'F - Vidas'[Tipo_plano] = "médico",
			                        'F - Vidas'[Operadora] = "Operadora Y",
			                        TREATAS({_UF}, 'F - Vidas'[uf_benef]),
			                        DATESYTD('D - Calendario'[Date])
			                    )
			                ),
			            "@Odo",
			            VAR _UF = [uf_benef]
			            RETURN
			                DIVIDE(
			                    CALCULATE(
			                        SUM('F - Aberturas por Risco'[Valor]),    
			                        'F - Aberturas por Risco'[Risco] = "Odontológico",
			                        'F - Aberturas por Risco'[Operadora] = "Operadora Y",
			                        DATESYTD('D - Calendario'[Date])
			                    ),
			                    CALCULATE(
			                        SUM('F - Vidas'[Valor]),
			                        'F - Vidas'[Tipo_plano] = "odontológico",
			                        'F - Vidas'[Operadora] = "Operadora Y",
			                        TREATAS({_UF}, 'F - Vidas'[uf_benef]),
			                        DATESYTD('D - Calendario'[Date])
			                    )
			                ),
			            "@Farm",
			            VAR _UF = [uf_benef]
			            RETURN
			                DIVIDE(
			                    CALCULATE(
			                        SUM('F - Aberturas por Risco'[Valor]),    
			                        'F - Aberturas por Risco'[Risco] = "Farmácia",
			                        'F - Aberturas por Risco'[Operadora] = "Operadora Y",
			                        DATESYTD('D - Calendario'[Date])
			                    ),
			                    CALCULATE(
			                        SUM('F - Vidas'[Valor]),
			                        'F - Vidas'[Nome_empresa] IN {"Empresa D", "Empresa E"},
			                        'F - Vidas'[Operadora] = "Operadora Y",
			                        TREATAS({_UF}, 'F - Vidas'[uf_benef]),
			                        DATESYTD('D - Calendario'[Date])
			                    )
			                )
			        ),
			        [uf_benef] <> ""
			    )
			
			VAR _Top1_GR_POS   = TOPN( 1, _TabelaUF_POS, [@GR],   DESC )
			VAR _Top1_PR_POS   = TOPN( 1, _TabelaUF_POS, [@PR],   DESC )
			VAR _Top1_Odo_POS  = TOPN( 1, _TabelaUF_POS, [@Odo],  DESC )
			VAR _Top1_Farm_POS = TOPN( 1, _TabelaUF_POS, [@Farm], DESC )
			
			VAR GR_UF_Top1 = MAXX(_Top1_GR_POS, [uf_benef])
			VAR GR_Top1_PerCapita = FORMAT(
			    MAXX(_Top1_GR_POS, [@GR]),
			    "R$ #,##0.00"
			)
			
			VAR PR_UF_Top1 = MAXX(_Top1_PR_POS, [uf_benef])
			VAR PR_Top1_PerCapita = FORMAT(
			    MAXX(_Top1_PR_POS, [@PR]),
			    "R$ #,##0.00"
			)
			
			VAR Odo_UF_Top1 = MAXX(_Top1_Odo_POS, [uf_benef])
			VAR Odo_Top1_PerCapita = FORMAT(
			    MAXX(_Top1_Odo_POS, [@Odo]),
			    "R$ #,##0.00"
			)
			
			VAR Farm_UF_Top1 = MAXX(_Top1_Farm_POS, [uf_benef])
			VAR Farm_Top1_PerCapita = FORMAT(
			    MAXX(_Top1_Farm_POS, [@Farm]),
			    "R$ #,##0.00"
			)
			
			VAR _Linha_GR_POS   = "- Grande Risco: "  & IF( 
			    COUNTROWS(_Top1_GR_POS)=0, 
			    "sem UF elegível (vidas ≤ 100)", 
			    GR_UF_Top1 & " com " & GR_Top1_PerCapita 
			)
			
			VAR _Linha_PR_POS   = "- Pequeno Risco: " & IF( 
			    COUNTROWS(_Top1_PR_POS)=0,   
			    "sem UF elegível (vidas ≤ 100)", 
			    PR_UF_Top1 & " com " & PR_Top1_PerCapita
			)
			
			VAR _Linha_Odo_POS  = "- Odontológico: "  & IF( 
			    COUNTROWS(_Top1_Odo_POS)=0,  
			    "sem UF elegível (vidas ≤ 100)", 
			    Odo_UF_Top1 & " com " & Odo_Top1_PerCapita
			)
			
			VAR _Linha_Farm_POS = "- Farmácia: "      & IF( 
			    COUNTROWS(_Top1_Farm_POS)=0, 
			    "sem UF elegível (vidas ≤ 100)", 
			    Farm_UF_Top1 & " com " & Farm_Top1_PerCapita
			)
			
			VAR _Bloco_POS = 
			    "As UFs Top 1 de custo per capita por categoria " & UNICHAR(10)
			    & " de risco foram: " & UNICHAR(10)
			    & _Linha_GR_POS   & UNICHAR(10)
			    & _Linha_PR_POS   & UNICHAR(10)
			    & _Linha_Odo_POS  & UNICHAR(10)
			    & _Linha_Farm_POS
			
			RETURN
			_Bloco_POS
			```
		lineageTag: c20e06bb-005e-4c28-a520-2d1c5a0dc5cb

