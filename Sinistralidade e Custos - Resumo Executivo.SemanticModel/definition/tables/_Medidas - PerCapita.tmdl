	measure _PerCapita_Grande_Risco =
			
			DIVIDE(
			    CALCULATE(
			        [_Valor_Base_Custo],
			        'F - Aberturas por Risco'[Risco] = "Grande Risco"
			    ),
			    CALCULATE(
			        [_Valor_Base_Vidas],
			        'F - Aberturas por Risco'[Tipo_plano] = "médico"
			    )
			)
		formatString: 0.00
		lineageTag: 5347fe2e-3a05-4066-b9dd-ae74e4056601

	measure _Valor_Base_Custo = ```
			
			VAR _ConsideraCopart =
			    SELECTEDVALUE('_Filtro Copart'[Copart])
			    
			VAR _ConsideraCassi =
			    SELECTEDVALUE('_Filtro Reciprocidade'[Cassi])
			
			RETURN
			    IF(
			        _ConsideraCassi = "Sem",
			        CALCULATE(
			            IF(
			                _ConsideraCopart = "Com",
			                SUM('F - Aberturas por Risco'[Valor]),
			                SUM('F - Aberturas por Risco'[VPP])
			            ),
			            'F - Aberturas por Risco'[cassi] = "Nao"
			        ),
			        IF(
			            _ConsideraCopart = "Com",
			            SUM('F - Aberturas por Risco'[Valor]),
			            SUM('F - Aberturas por Risco'[VPP])
			        )
			    )
			```
		lineageTag: 0d70b18d-29e4-4768-b98f-1a96e2e8ab0d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _Valor_Base_Vidas = SUM('F - Vidas'[Valor])
		lineageTag: 936e48fb-af2c-4f57-8137-ce406e358b18

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _PerCapita_Pequeno_Risco =
			
