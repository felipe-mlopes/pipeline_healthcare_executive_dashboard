	measure POS_PerCapita_com_Filtro = ```
			
			VAR _ConsideraCassi =
			    SELECTEDVALUE('_Filtro Reciprocidade'[Cassi])
			
			RETURN 
			    IF(
			        _ConsideraCassi = "Sem",
			        CALCULATE(
			            [POS_PerCapita],
			            'F - Custo Pos Pgto'[cassi] = "Não"
			        ),
			        [POS_PerCapita]
			    )
			```
		lineageTag: 5a48face-6ba1-43d3-9f72-a18fe9854c85

		annotation PBI_FormatHint = {"isGeneralNumber":true}

