	measure PRE_Vidas_Periodo_Passado_Dinamico = ```
			
			VAR PeriodoSelecionado = SELECTEDVALUE('D - Tabela Periodos'[Periodo])
			VAR DataPgto = '_Medidas - Geral'[Ultima_Data_Pgto]
			VAR DataPgto_AnoAnterior =
			    DATE(
			        YEAR(DataPgto) - 1,
			        MONTH(DataPgto),
			        DAY(DataPgto)
			    )
			VAR PrimeiraData_AnoAnterior = 
			    DATE(
			        YEAR(DataPgto) - 1,
			        1,
			        1
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    PeriodoSelecionado = "Últimos 12 meses",
			        DIVIDE(
			            CALCULATE(
			                [PRE_Vidas],
			                DATESINPERIOD('D - Calendario'[Date], [Penultimos_12M], -12, MONTH)
			            ),
			            12
			        ),
			
			    PeriodoSelecionado = "Últimos 6 meses",
			        DIVIDE(
			            CALCULATE(
			                [PRE_Vidas],
			                DATESINPERIOD('D - Calendario'[Date], [Penultimos_12M], -6, MONTH)
			            ),
			            6
			        ),
			
			    PeriodoSelecionado = "Mês Pgtº Vigente",
			        CALCULATE(
			            [PRE_Vidas],
			            FILTER(
			                ALL('D - Calendario'),
			                'D - Calendario'[Date] >= DATE(YEAR(DataPgto_AnoAnterior), MONTH(DataPgto_AnoAnterior), 1) &&
			                'D - Calendario'[Date] <= DataPgto_AnoAnterior
			            )
			        ),
			
			    PeriodoSelecionado = "YTD",
			        DIVIDE(
			            CALCULATE(
			                [PRE_Vidas],
			                DATESBETWEEN(
			                    'D - Calendario'[Date], 
			                    PrimeiraData_AnoAnterior, 
			                    DataPgto_AnoAnterior
			                )
			            ),
			            CALCULATE(
			                DISTINCTCOUNT(
			                    'D - Calendario'[AnoMes]
			                ),
			                DATESBETWEEN(
			                    'D - Calendario'[Date], 
			                    PrimeiraData_AnoAnterior, 
			                    DataPgto_AnoAnterior
			                )
			            )
			        ),
			
			    BLANK()
			)
			```
		formatString: #,0
		lineageTag: c898fc65-97a9-4a9f-985f-ff66a8dbed0e

		annotation PBI_FormatHint = {"isDecimal":true}

