			VAR yoy =
			    DIVIDE(
			        VidasAtual - [POS_Vidas_Periodo_Passado_Dinamico],
			        ABS([POS_Vidas_Periodo_Passado_Dinamico])
			    )
			
			VAR cor_fonte_yoy =
			    IF(yoy >= 0, cor_negativo, cor_positivo)
			
			VAR cor_badge_fundo =
			    IF(yoy >= 0, cor_badge_fundo_negativo, cor_badge_fundo_positivo)
			
			VAR icone_variacao =
			    IF(yoy >= 0, "↗", "↘")
			
			VAR yoy_formatado =
			    FORMAT(ABS(yoy), "0.0%")
			
			-- ╔══════════════════════════════════════════════════════════════════╗
			-- ║                   🧱 MONTAGEM DO HTML                           ║
			-- ╚══════════════════════════════════════════════════════════════════╝
			
			RETURN
			"
			<div style='
			    width:" & largura_card & ";
			    height:" & altura_card & ";
			    box-sizing:border-box;
			    background:" & cor_fundo_card & ";
			    border:1px solid " & cor_borda_card & ";
			    border-radius:" & raio_borda & ";
			    padding:" & padding_card & ";
			    font-family:" & fonte_principal & ";
			    box-shadow:" & sombra_card & ";
			    display:flex;
			    justify-content:space-between;
			    align-items:top;
			    overflow:hidden;
			'>
			
			    <div style='
			        display:flex;
			        flex-direction:column;
			        justify-content:center;
			        height:100%;
			        min-width:0;
			    '>
			
			        <div style='display:flex; align-items:center; gap:" & gap_header & ";'>
			            " & IconeSVG & "
			
			            <div style='
			                color:" & cor_titulo & ";
			                font-family:" & fonte_titulo & ";
			                font-size:" & tamanho_titulo & ";
			                font-weight:" & peso_titulo & ";
			                line-height:1.15;
			                max-width:220px;
			                white-space:normal;
			            '>
			                " & titulo_card & "
			            </div>
			        </div>
			
			        <div style='
			            color:" & cor_valor & ";
			            font-family:" & fonte_valor & ";
			            font-size:" & tamanho_valor & ";
			            font-weight:" & peso_valor & ";
			            letter-spacing:" & espacamento_letra_valor & ";
			            line-height:1;
			            margin-top:" & margin_valor_top & ";
			            white-space:nowrap;
			        '>
			            " & valor_formatado & "
			        </div>
			
			                <div style='
			            display:flex;
			            align-items:center;
			            gap:" & gap_badge & ";
			            margin-top:" & margin_badge_top & ";
			            white-space:nowrap;
			        '>
			            <div style='
			                background:" & cor_badge_fundo & ";
			                color:" & cor_fonte_yoy & ";
			                border-radius:" & raio_badge & ";
			                padding:" & padding_badge_vertical & " " & padding_badge_horizontal & ";
			                font-family:" & fonte_label_comparativo & ";
			                font-size:" & tamanho_label_comparativo & ";
			                font-weight:" & peso_label_comparativo & ";
			                line-height:1;
			                white-space:nowrap;
			            '>
			                " & icone_variacao & " " & yoy_formatado & "
			            </div>
			
			            <div style='
			                color:" & cor_texto_secundario & ";
			                font-family:" & fonte_label_comparativo & ";
			                font-size:" & tamanho_label_comparativo & ";
			                font-weight:" & peso_label_comparativo & ";
			                white-space:nowrap;
			            '>
			                " & texto_comparativo & "
			            </div>
			        </div>
			    </div>
			
			</div>
			"
		lineageTag: 67d7ab8d-8fdc-4422-9805-e8cce62b9260

	measure PRE_Barra_Meta = ```
			
			-- ──────────────────────────────────────────────────────────────────
			-- 🔎 ESCALA GERAL
			-- ──────────────────────────────────────────────────────────────────
			
			VAR EscalaConteudoPercentual = 30
			VAR EscalaCardPercentual = 30
			
			VAR FatorEscalaConteudo = DIVIDE(EscalaConteudoPercentual, 100)
			VAR FatorEscalaCard = DIVIDE(EscalaCardPercentual, 100)
			
			-- ──────────────────────────────────────────────────────────────────
			-- 🔤 FONTES
			-- ──────────────────────────────────────────────────────────────────
			
			VAR fonte_principal = "Poppins, Segoe UI, Arial, sans-serif"
			
			-- ──────────────────────────────────────────────────────────────────
			-- 📝 TEXTOS DO CARD
			-- ──────────────────────────────────────────────────────────────────
			
			VAR titulo_card = "Meta Per Capita"
			
			-- ──────────────────────────────────────────────────────────────────
			-- 📦 CARD / CONTAINER
			-- ──────────────────────────────────────────────────────────────────
			
			VAR largura_card = ROUND(410 * FatorEscalaCard, 0) & "px"
			VAR altura_card = ROUND(308 * FatorEscalaCard, 0) & "px"
			VAR raio_borda = ROUND(34 * FatorEscalaCard, 0) & "px"
			VAR padding_card = ROUND(12 * FatorEscalaCard, 0) & "px"
			
			VAR cor_fundo_card = "#FFFFFF"
			VAR cor_borda_card = "#E8EAF2"
			
			VAR ExibirSombraCard = FALSE()
			VAR sombra_card =
			    IF(
			        ExibirSombraCard,
			        "0 18px 38px rgba(15, 23, 42, 0.10)",
			        "none"
			    )
			
			-- ──────────────────────────────────────────────────────────────────
			-- 🎨 CORES GERAIS
			-- ──────────────────────────────────────────────────────────────────
			
			VAR cor_titulo = "#8A8F9C"
			VAR cor_valor = "#1F2937"
			VAR cor_texto_secundario = "#8A8F9C"
			
			VAR cor_abaixo_meta_maximo = "#2563EB" -- azul
			VAR cor_entre_meta_maximo_alvo = "#32D60D" -- verde
			VAR cor_entre_meta_alvo_minima = "#F5E911" -- amarelo
			VAR cor_acima_meta_minima = "#DC2626" -- vermelho
			
			-- ──────────────────────────────────────────────────────────────────
			-- 🏷️ TÍTULO
			-- ──────────────────────────────────────────────────────────────────
			
			VAR fonte_titulo = fonte_principal
			VAR peso_titulo = "700"
			VAR tamanho_titulo = ROUND(28 * FatorEscalaConteudo, 0) & "px"
			
			
			-- ──────────────────────────────────────────────────────────────────
			-- 💰 VALOR PRINCIPAL
			-- ──────────────────────────────────────────────────────────────────
			
			VAR fonte_valor = fonte_principal
			VAR peso_valor = "700"
			VAR tamanho_valor = ROUND(56 * FatorEscalaConteudo, 0) & "px"
			VAR espacamento_letra_valor = "-2.4px"
			
			-- ──────────────────────────────────────────────────────────────────
			-- ⚙️ LÓGICA DE NEGÓCIO
			-- ──────────────────────────────────────────────────────────────────
			
			VAR Valor = [PRE_PerCapita_Periodo_Atual_Dinamico]
			VAR Minimo = [PRE_Meta_Max]
			VAR Alvo = [PRE_Meta_Alvo]
			VAR Maximo = [PRE_Meta_Min]
			
			VAR PercBarra =
			    DIVIDE(Valor, Maximo, 0) * 100
			
			VAR EscalaMaxima = 
			    Maximo * 1.2
			
			VAR PosMin =
			    DIVIDE(Minimo, EscalaMaxima) * 100
			
			VAR PosAlvo =
			    DIVIDE(Alvo, EscalaMaxima) * 100
			
			VAR PosMax =
			    DIVIDE(Maximo, EscalaMaxima) * 100
			
			VAR PercBarraFinal =
			    DIVIDE(Valor, EscalaMaxima, 0) * 100
			
			VAR CorBarra =
			    SWITCH (
			        TRUE(),
			        Valor < Minimo, cor_abaixo_meta_maximo,
			        Valor < Alvo, cor_entre_meta_maximo_alvo,
			        Valor <= Maximo, cor_entre_meta_alvo_minima,
			        cor_acima_meta_minima
			    )
			
			VAR Status_Barra =
			    SWITCH (
			        TRUE(),
			        Valor < Minimo, "Abaixo da Meta Máxima",
			        Valor < Alvo, "Entre a Meta Máxima e a Alvo",
			        Valor <= Maximo, "Entre a Meta Alvo e a Mínima",
			        "Acima da Meta Mínima"
			    )
			
			VAR Valor_Formato = 
			    "R$ " & FORMAT(Valor, "#,##0.00")
			
			VAR Min_Formato =
			    "R$ " & FORMAT(Minimo, "#,##0.00")
			
			VAR Alvo_Formato =
			    "R$ " & FORMAT(Alvo, "#,##0.00")
			
			VAR Max_Formato =
			    "R$ " & FORMAT(Maximo, "#,##0.00")
			
			VAR Valor_Barra =
			    SUBSTITUTE(
			        FORMAT(PercBarraFinal,"0.0"),
			        ",",
			        "."
			    )
			
			-- ╔══════════════════════════════════════════════════════════════════╗
			-- ║                   🧱 MONTAGEM DO HTML                           ║
			-- ╚══════════════════════════════════════════════════════════════════╝
			
			RETURN
			
			"<div style='
			    font-family:" & fonte_principal & ";
			    padding:" & padding_card & ";
			    background:" & cor_fundo_card & ";
			    border-radius:" & raio_borda & ";
			    box-shadow:" & sombra_card & ";
			'>
			    <div style='
			        font-size:16px;
			        font-weight:" & peso_titulo & ";
			        color:" & cor_titulo & ";
			        margin-bottom:10px;'>
			        " & titulo_card & "
			    </div>
			
			    <div style='display:flex;justify-content:space-between;
			                margin-bottom:4px;font-size:12px;font-weight:600;'>
			        <span>" & Status_Barra & "</span>
			        <span>" & Valor_Formato & "</span>
			    </div>
			
			    <div style='position:relative;width:100%;height:22px;'>
			
			        <div style='
			            width:100%;
			            height:18px;
			            background:#E5E7EB;
			            border-radius:9px;
			            overflow:hidden;'>
			
			            <div style='
			                width:" & Valor_Barra & "%;
			                height:100%;
			                background:" & CorBarra & ";
			                border-radius:9px;'>
			            </div>
			
			        </div>
			
			        <!-- Marco Meta Min -->
			        <div style='
			            position:absolute;
			            left:calc(" & SUBSTITUTE(FORMAT(PosMin,"0.0"),",",".") & "% - 1px);
			            transform:translateX(-50%);
			            top:-4px;
			            width:3px;
			            height:26px;
			            background:"& cor_abaixo_meta_maximo &";
			            z-index:2;'>
			        </div>
			
			
			        <!-- Marco Meta Alvo -->
			        <div style='
			            position:absolute;
			            left:calc(" & SUBSTITUTE(FORMAT(PosAlvo,"0.0"),",",".") & "% - 1px);
			            transform:translateX(-50%);
			            top:-4px;
			            width:3px;
			            height:26px;
			            background:"& cor_entre_meta_maximo_alvo &";
			            z-index:2;'>
			        </div>
			
			        <!-- Marco Meta Max -->
			        <div style='
			            position:absolute;
			            left:calc(" & SUBSTITUTE(FORMAT(PosMax,"0.0"),",",".") & "% - 1px);
			            transform:translateX(-50%);
			            top:-4px;
			            width:3px;
			            height:26px;
			            background:"& cor_entre_meta_alvo_minima &";
			            z-index:2;'>
			        </div>
			
			    </div>
			
			    <footer style='
			        display:flex;
			        justify-content:space-between;
			        margin-top:14px;
			        padding-top:8px;
			        border-top:1px solid #E5E7EB;'>
			
			        <div style='
			            flex:1;
			            text-align:center;'>
			
			            <div style='
			                display:flex;
			                align-items:center;
			                justify-content:center;
			                gap:6px;
			            '>
			
			                <div style='
			                    width:3px;
			                    height:18px;
			                    background:"& cor_abaixo_meta_maximo &";
			                '>
			                </div>
			
			                <span style='
			                    font-size:11px;
			                    color:#666;
			                '>
			                    Meta Máxima
			                </span>
			
			            </div>
			
			            <div style='
			                font-size:14px;
			                font-weight:600;
			                color:#333;
			            '>
			                " & Min_Formato & "
			            </div>
			
			        </div>
			
			        <div style='
			            flex:1;
			            text-align:center;
			        '>
			
			            <div style='
			                display:flex;
			                align-items:center;
			                justify-content:center;
			                gap:6px;
			            '>
			
			                <div style='
			                    width:3px;
			                    height:18px;
			                    background:"& cor_entre_meta_maximo_alvo &";
			                '>
			                </div>
			
			                <span style='
			                    font-size:11px;
			                    color:#666;
			                '>
			                    Meta Alvo
			                </span>
			
			            </div>
			
			            <div style='
			                font-size:14px;
			                font-weight:600;
			                color:#333;
			            '>
			                " & Alvo_Formato & "
			            </div>
			
			        </div>
			
			        <div style='
			            flex:1;
			            text-align:center;
			        '>
			
			            <div style='
			                display:flex;
			                align-items:center;
			                justify-content:center;
			                gap:6px;
			            '>
			
			                <div style='
			                    width:3px;
			                    height:18px;
			                    background:"& cor_entre_meta_alvo_minima &";
			                '>
			                </div>
			
			                <span style='
			                    font-size:11px;
			                    color:#666;
			                '>
			                    Meta Mínima
			                </span>
			
			            </div>
			
			            <div style='
			                font-size:14px;
			                font-weight:600;
			                color:#333;
			            '>
			                " & Max_Formato & "
			            </div>
			
			        </div>
			
			    </footer>
			
			</div>"
			```
		lineageTag: 2cfde1da-141f-4ac8-bd17-8d22c7423ae0

	measure PRE_Sinistralidade_Variação_Cor =
			
			VAR VariacaoSinistralidade =
			    ([PRE_Sinistralidade_Periodo_Atual_Dinamico]
			    - [PRE_Sinistralidade_Periodo_Passado_Dinamico]) * 100
			
			RETURN
			    SWITCH(
			        TRUE(),
			        VariacaoSinistralidade < 0, "#16A34A", -- Verde
			        VariacaoSinistralidade > 0, "#DC2626", -- Vermelho
			        "#6B7280"                              -- Cinza
			    )
		lineageTag: 55540c8e-f80a-49c5-90dd-22c612363db3

	measure PRE_PerCapita_Variação_Cor = ```
			
