	measure POS_Vidas_Periodo_Atual_Dinamico = ```
			
			VAR PeriodoSelecionado = SELECTEDVALUE('D - Tabela Periodos'[Periodo])
			VAR DataPgto = [Ultima_Data_Pgto]
			VAR PrimeiraDataPgto =
			    DATE(
			        YEAR(DataPgto),
			        1,
			        1
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    PeriodoSelecionado = "Últimos 12 meses",
			        DIVIDE(
			            CALCULATE(
			                [POS_Vidas],
			                DATESINPERIOD('D - Calendario'[Date], [Ultimos_12M], -12, MONTH)
			            ),
			            12
			        ),
			
			    PeriodoSelecionado = "Últimos 6 meses",
			        DIVIDE(
			            CALCULATE(
			                [POS_Vidas],
			                DATESINPERIOD('D - Calendario'[Date], [Ultimos_12M], -6, MONTH)
			            ),
			            6
			        ),
			
			    PeriodoSelecionado = "Mês Pgtº Vigente",
			        CALCULATE(
			            [POS_Vidas],
			            FILTER(
			                ALL('D - Calendario'),
			                'D - Calendario'[Date] >= DATE(YEAR(DataPgto), MONTH(DataPgto), 1) &&
			                'D - Calendario'[Date] <= DataPgto
			            )
			        ),
			
			    PeriodoSelecionado = "YTD",
			        DIVIDE(
			            CALCULATE(
			                [POS_Vidas],
			                DATESYTD('D - Calendario'[Date])
			            ),
			            CALCULATE(
			                DISTINCTCOUNT(
			                    'D - Calendario'[AnoMes]
			                ),
			                DATESBETWEEN(
			                    'D - Calendario'[Date], 
			                    PrimeiraDataPgto, 
			                    DataPgto
			                )
			            )
			        ),
			
			    BLANK()
			)
			```
		formatString: #,0
		lineageTag: 45a5cd0a-c54f-4ec0-8059-2071fa8c7e73

		annotation PBI_FormatHint = {"isDecimal":true}

	measure POS_Vidas_Periodo_Passado_Dinamico = ```
			
			VAR PeriodoSelecionado = SELECTEDVALUE('D - Tabela Periodos'[Periodo])
			VAR DataPgto = '_Medidas - Geral'[Ultima_Data_Pgto]
			VAR DataPgto_AnoAnterior =
			    DATE(
			        YEAR(DataPgto) - 1,
			        MONTH(DataPgto),
			        DAY(DataPgto)
			    )
			VAR PrimeiraData_AnoAnterior = 
			    DATE(
			        YEAR(DataPgto) - 1,
			        1,
			        1
			    )
			    
			RETURN
			SWITCH(
			    TRUE(),
			
			    PeriodoSelecionado = "Últimos 12 meses",
			        DIVIDE(
			            CALCULATE(
			                [POS_Vidas],
			                DATESINPERIOD('D - Calendario'[Date], [Penultimos_12M], -12, MONTH)
			            ),
			            12
			        ),
			
			    PeriodoSelecionado = "Últimos 6 meses",
			        DIVIDE(
			            CALCULATE(
			                [POS_Vidas],
			                DATESINPERIOD('D - Calendario'[Date], [Penultimos_12M], -6, MONTH)
			            ),
			            6
			        ),
			
			    PeriodoSelecionado = "Mês Pgtº Vigente",
			        CALCULATE(
			            [POS_Vidas],
			            FILTER(
			                ALL('D - Calendario'),
			                'D - Calendario'[Date] >= DATE(YEAR(DataPgto_AnoAnterior), MONTH(DataPgto_AnoAnterior), 1) &&
			                'D - Calendario'[Date] <= DataPgto_AnoAnterior
			            )
			        ),
			
			    PeriodoSelecionado = "YTD",
			        DIVIDE(
			            CALCULATE(
			                [POS_Vidas],
			                DATESBETWEEN(
			                    'D - Calendario'[Date], 
			                    PrimeiraData_AnoAnterior, 
			                    DataPgto_AnoAnterior
			                )
			            ),
			            CALCULATE(
			                DISTINCTCOUNT(
			                    'D - Calendario'[AnoMes]
			                ),
			                DATESBETWEEN(
			                    'D - Calendario'[Date], 
			                    PrimeiraData_AnoAnterior, 
			                    DataPgto_AnoAnterior
			                )
			            )
			        ),
			
			    BLANK()
			)
			```
		formatString: #,0
		lineageTag: 0f237ca4-10df-4038-a8e4-488447daa414

		annotation PBI_FormatHint = {"isDecimal":true}

	measure POS_Vidas_Variação =
			
			VAR VariacaoVidas = DIVIDE([POS_Vidas_Periodo_Atual_Dinamico] - [POS_Vidas_Periodo_Passado_Dinamico], [POS_Vidas_Periodo_Passado_Dinamico])
			RETURN
			    IF(
			        VariacaoVidas < 0,
			        "↓ " & FORMAT(VariacaoVidas, "0.00%"),
			        "↑ " & FORMAT(VariacaoVidas, "0.00%")
			    )
		lineageTag: 581dc836-56f1-4c82-8e56-1aa47d2613f2

