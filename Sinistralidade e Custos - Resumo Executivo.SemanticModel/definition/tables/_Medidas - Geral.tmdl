table '_Medidas - Geral'
	lineageTag: e43f3d7e-5e55-4588-84b2-304000638112

	measure Ultima_Data_Pgto = ```
			
			VAR Hoje = TODAY()
			RETURN 
			    IF(
			        DAY(Hoje) < 10,
			        DATE(YEAR(Hoje),MONTH(Hoje)-2,1),
			        DATE(YEAR(Hoje),MONTH(Hoje)-1,1)
			    )
			```
		formatString: General Date
		lineageTag: 2132bf55-7a27-42db-b131-fe8c16a85878

	measure PRE_Sinistralidade_Periodo_Atual_Dinamico =
			
			VAR PeriodoSelecionado = SELECTEDVALUE('D - Tabela Periodos'[Periodo])
			VAR DataPgto = '_Medidas - Geral'[Ultima_Data_Pgto]
			RETURN
			SWITCH(
			    TRUE(),
			
			    PeriodoSelecionado = "Últimos 12 meses",
			        CALCULATE(
			            [PRE_Sinistralidade],
			            DATESINPERIOD('D - Calendario'[Date], [Ultimos_12M], -12, MONTH)
			        ),
			
			    PeriodoSelecionado = "Últimos 6 meses",
			        CALCULATE(
			            [PRE_Sinistralidade],
			            DATESINPERIOD('D - Calendario'[Date], [Ultimos_12M], -6, MONTH)
			        ),
			
			    PeriodoSelecionado = "Mês Pgtº Vigente",
			        CALCULATE(
			            [PRE_Sinistralidade],
			            FILTER(
			                ALL('D - Calendario'),
			                'D - Calendario'[Date] >= DATE(YEAR(DataPgto), MONTH(DataPgto), 1) &&
			                'D - Calendario'[Date] <= DataPgto
			            )
			        ),
			
			    PeriodoSelecionado = "YTD",
			        CALCULATE(
			            [PRE_Sinistralidade],
			            DATESYTD('D - Calendario'[Date])
			        ),
			
			    BLANK()
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9710dbb9-8b37-44d7-915e-07a12a7d4a02

	measure PRE_Sinistralidade_Periodo_Passado_Dinamico = ```
			
			VAR PeriodoSelecionado = SELECTEDVALUE('D - Tabela Periodos'[Periodo])
			VAR DataPgto = '_Medidas - Geral'[Ultima_Data_Pgto]
			VAR DataPgto_AnoAnterior =
			    DATE(
			        YEAR(DataPgto) - 1,
			        MONTH(DataPgto),
			        DAY(DataPgto)
			    )
			VAR PrimeiraData_AnoAnterior = 
			    DATE(
			        YEAR(DataPgto) - 1,
			        1,
			        1
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    PeriodoSelecionado = "Últimos 12 meses",
			        CALCULATE(
			            [PRE_Sinistralidade],
			            DATESINPERIOD('D - Calendario'[Date], [Penultimos_12M], -12, MONTH)
			        ),
			
			    PeriodoSelecionado = "Últimos 6 meses",
			        CALCULATE(
			            [PRE_Sinistralidade],
			            DATESINPERIOD('D - Calendario'[Date], [Penultimos_12M], -6, MONTH)
			        ),
			
			    PeriodoSelecionado = "Mês Pgtº Vigente",
			        CALCULATE(
			            [PRE_Sinistralidade],
			            FILTER(
			                ALL('D - Calendario'),
			                'D - Calendario'[Date] >= DATE(YEAR(DataPgto_AnoAnterior), MONTH(DataPgto_AnoAnterior), 1) &&
			                'D - Calendario'[Date] <= DataPgto_AnoAnterior
			            )
			        ),
			
			    PeriodoSelecionado = "YTD",
			        CALCULATE(
			            [PRE_Sinistralidade],
			            DATESBETWEEN(
			                'D - Calendario'[Date], 
			                PrimeiraData_AnoAnterior, 
			                DataPgto_AnoAnterior
			            )
			        ),
			
			    BLANK()
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0d9e625c-1e3d-4102-bdf0-1b37ff4e0df9

