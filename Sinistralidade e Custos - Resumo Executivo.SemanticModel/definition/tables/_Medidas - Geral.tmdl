	measure POS_PerCapita_Variação = ```
			
			VAR VariacaoPerCapita = DIVIDE([POS_PerCapita_Periodo_Atual_Dinamico] - [POS_PerCapita_Periodo_Passado_Dinamico], [POS_PerCapita_Periodo_Passado_Dinamico])
			RETURN
			    IF(
			        VariacaoPerCapita = 0,
			        "", 
			        IF (
			            VariacaoPerCapita < 0,
			            "↓ " & FORMAT(VariacaoPerCapita, "0.00%"),
			            "↑ " & FORMAT(VariacaoPerCapita, "0.00%")
			    ))
			```
		lineageTag: a85f33b8-5b1f-48dd-b60e-22a3d449146b

