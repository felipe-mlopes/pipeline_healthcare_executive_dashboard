			-- ╚══════════════════════════════════════════════════════════════════╝
			
			VAR PercapitaAtual =
			    [PRE_PerCapita_Periodo_Atual_Dinamico]
			
			VAR PercapitaAtualAbsoluto =
			    ABS(PercapitaAtual)
			
			VAR valor_formatado =
			    IF(
			        PercapitaAtual < 0,
			        "-R$ " & FORMAT(ABS(PercapitaAtual), "#,##0.00"),
			        "R$ " & FORMAT(PercapitaAtual, "#,##0.00")
			    )
			
			VAR yoy =
			    DIVIDE(
			        PercapitaAtual - [PRE_PerCapita_Periodo_Passado_Dinamico],
			        ABS([PRE_PerCapita_Periodo_Passado_Dinamico])
			    )
			
			VAR cor_fonte_yoy =
			    IF(yoy >= 0, cor_positivo, cor_negativo)
			
