	measure Penultimos_12M =
			
			VAR DataAnoAnterior = DATE(YEAR(TODAY())-1, MONTH(TODAY()), DAY(TODAY()))
			RETURN
			    IF(
			        DAY(DataAnoAnterior) < 10,
			        DATE(YEAR(DataAnoAnterior),MONTH(DataAnoAnterior)-2,1),
			        DATE(YEAR(DataAnoAnterior),MONTH(DataAnoAnterior)-1,1)
			    )
		formatString: General Date
		lineageTag: f161db01-74e1-4f36-b9e1-3a0c6f699d94

	measure Antepenultimos_12M =
			
